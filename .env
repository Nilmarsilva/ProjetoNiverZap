# Variáveis de ambiente lidas pelo docker-compose
# Banco de dados PostgreSQL
POSTGRES_DB=niverzap
POSTGRES_USER=niverzap
POSTGRES_PASSWORD=sua-senha-aqui
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSL=disable

# Chave interna do projeto
SECRET_KEY=algumasecret

# Redis (ajuste se usar Docker local para Redis também)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Supabase (preencha se/ quando usar)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# Integrações de WhatsApp / Evolution (preencher quando disponível)
ZAPI_INSTANCE=
ZAPI_TOKEN=
WHATSAPP_OFFICIAL_PHONE_ID=
WHATSAPP_OFFICIAL_TOKEN=
WHATSAPP_OFFICIAL_VERSION=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
