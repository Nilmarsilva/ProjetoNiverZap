FROM node:16

WORKDIR /app

# Copiar arquivos de dependências
COPY ./zap-niver-dashboard/server/package*.json ./

# Instalar dependências
RUN npm install

# Copiar o restante dos arquivos da aplicação
COPY ./zap-niver-dashboard/server .

# Expor a porta que a aplicação usa
EXPOSE 5001

# Criar um servidor simples para teste
RUN echo 'const express = require("express"); \n\
const app = express(); \n\
const PORT = 5001; \n\
\n\
app.get("/api/health", (req, res) => { \n\
  res.status(200).json({ status: "ok", message: "Servidor funcionando!" }); \n\
}); \n\
\n\
app.listen(PORT, "0.0.0.0", () => { \n\
  console.log(`Servidor rodando na porta ${PORT}`); \n\
});' > server-test.js

# Comando para iniciar a aplicação
CMD ["node", "server-test.js"]
